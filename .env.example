# Copiar a .env y reemplazar cada valor antes de ejecutar docker compose.
POSTGRES_DB=bi_envasado
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_PORT=5432

GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=cambiar_esto
GRAFANA_PORT=3000

# Secreto para seudonimizar personas de forma estable. Si cambia, cambian los seudonimos.
ANONYMIZATION_SALT=cambiar_esto

# Archivo fuente dentro de data/source/
SOURCE_FILE=SEGUIMIENTO TEMPERAS Y VINILOS Actividad.xlsm

# Clave del usuario de solo lectura bi_lector, que usan Grafana y Power BI.
# Se crea al iniciar la base por primera vez; si la cambia, recree el volumen (docker compose down -v).
BI_READER_PASSWORD=cambiar_esto

# Token con el que Grafana entrega sus alertas al simulador (webhook). Genere uno propio, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ALERT_WEBHOOK_TOKEN=cambiar_esto

# Opcional: segundos reales que equivalen a una hora de produccion simulada (por defecto 15).
# SIM_SEGUNDOS_POR_HORA=15
