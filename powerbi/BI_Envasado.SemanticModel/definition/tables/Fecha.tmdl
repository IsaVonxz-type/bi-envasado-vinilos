	column 'Es fin de semana'
		dataType: boolean
		lineageTag: ba0c60c0-3327-57b8-ba0e-5cc2ae8275fa
		summarizeBy: none
		sourceColumn: es_fin_semana

		annotation SummarizationSetBy = Automatic

	/// Verdadero cuando el mes tiene al menos 30 filas de no operación. Los meses normales tienen entre 38 y 125; desde julio de 2024 hay 11 o menos.
	column 'Mes con registro de no operación' =
			CALCULATE (
			    COUNTROWS ( NoOperacion ),
			    ALLEXCEPT ( Fecha, Fecha[Año-Mes] )
			) >= 30
		dataType: boolean
		lineageTag: 0f0ac81c-217a-5fdd-9041-2883b1a5d51e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	hierarchy 'Jerarquía de fecha'
