	partition Fecha = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Datos = Origen{[Schema="dw", Item="dim_fecha"]}[Data],
				    Columnas = Table.SelectColumns(Datos, {"fecha_key", "fecha", "anio", "semestre", "trimestre", "mes", "nombre_mes", "anio_mes", "semana_iso", "dia_semana", "nombre_dia", "es_fin_semana"})
				in
				    Columnas

	annotation PBI_ResultType = Table
