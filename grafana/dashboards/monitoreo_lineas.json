          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.causa AS \"Causa\", SUM(p.minutos) AS \"Minutos\"\nFROM ops.paro_hora p\nJOIN ops.lectura_hora l USING (lectura_id)\nWHERE $__timeFilter(p.ts) AND l.maquina IN ($maquina) AND l.turno IN ($turno) AND p.clasificacion = 'No programado'\nGROUP BY p.causa\nORDER BY 2 DESC\nLIMIT 8",
          "refId": "A"
        }
      ],
