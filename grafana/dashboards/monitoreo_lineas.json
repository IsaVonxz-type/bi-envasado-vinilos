    {
      "id": 10,
      "type": "table",
      "title": "Alertas entregadas al webhook",
      "description": "Avisos que Grafana entregó al receptor de alertas. Cada alerta se registra al dispararse (firing) y al resolverse (resolved).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
