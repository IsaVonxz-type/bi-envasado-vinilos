    {
      "id": 3,
      "type": "timeseries",
      "title": "Disponibilidad móvil de 4 horas",
      "description": "Tiempo operativo sobre tiempo planificado de las últimas 4 lecturas, por línea. Es la serie que evalúa la regla de alerta; la línea discontinua marca el umbral de 40 %.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, maquina AS metric, disp AS \"Disponibilidad móvil 4 h\"\nFROM (\n  SELECT ts AS time, maquina, turno,\n         SUM(minutos_operativos) OVER w / NULLIF(SUM(minutos_planificados) OVER w, 0) AS disp\n  FROM ops.lectura_hora\n  WHERE ts BETWEEN $__timeFrom()::timestamptz - interval '2 minutes' AND $__timeTo()::timestamptz AND maquina IN ($maquina)\n  WINDOW w AS (PARTITION BY maquina ORDER BY ts ROWS BETWEEN 3 PRECEDING AND CURRENT ROW)\n) t\nWHERE $__timeFilter(time) AND turno IN ($turno)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "OEE móvil de 4 horas",
      "description": "Disponibilidad × rendimiento × calidad de las últimas 4 lecturas. La calidad es un supuesto del 100 %, por lo que es un máximo. Líneas: 75 % (primera meta) y 85 % (largo plazo).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, maquina AS metric, oee AS \"OEE móvil 4 h\"\nFROM (\n  SELECT ts AS time, maquina, turno,\n         SUM(minutos_operativos) OVER w / NULLIF(SUM(minutos_planificados) OVER w, 0)\n           * SUM(unidades_producidas) OVER w / NULLIF(SUM(unidades_teoricas) OVER w, 0) AS oee\n  FROM ops.lectura_hora\n  WHERE ts BETWEEN $__timeFrom()::timestamptz - interval '2 minutes' AND $__timeTo()::timestamptz AND maquina IN ($maquina)\n  WINDOW w AS (PARTITION BY maquina ORDER BY ts ROWS BETWEEN 3 PRECEDING AND CURRENT ROW)\n) t\nWHERE $__timeFilter(time) AND turno IN ($turno)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "blue",
                "value": 0.85
              }
            ]
          },
          "min": 0,
          "max": 1.1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Minutos de paro por clasificación",
      "description": "Minutos de paro de cada hora, separando los programados (aseo, pausas) de los no programados.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.ts AS time, p.clasificacion AS metric, SUM(p.minutos) AS \"Minutos de paro\"\nFROM ops.paro_hora p\nJOIN ops.lectura_hora l USING (lectura_id)\nWHERE $__timeFilter(p.ts) AND l.maquina IN ($maquina) AND l.turno IN ($turno)\nGROUP BY p.ts, p.clasificacion\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Causas principales de paro no programado",
      "description": "Minutos por causa en el periodo seleccionado. Es la misma lectura que el Pareto del tablero de Power BI, en tiempo real.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi-postgres"
