        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT recibido_en AS \"Recibida\", estado AS \"Estado\", regla AS \"Regla\", maquina AS \"Máquina\",\n       valor AS \"Valor\", severidad AS \"Severidad\"\nFROM ops.alerta_recibida\nORDER BY recibido_en DESC\nLIMIT 15",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
